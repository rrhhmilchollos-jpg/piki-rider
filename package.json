{
  "name": "piki-rider",
  "private": true,
  "version": "1.0.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-release.mjs && tsc -b && vite build && node scripts/check-release-version.mjs --dist",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "oxlint --ignore-pattern public/sw.js",
    "preview": "vite preview",
    "test:android": "python3 scripts/test-android-identity.py && python3 scripts/test-android-workflows.py && node --test scripts/test-android-signing.mjs scripts/test-play-release.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@zxing/browser": "0.1.5",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "leaflet": "^1.9.4",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": "10.4.1"
  }
}
